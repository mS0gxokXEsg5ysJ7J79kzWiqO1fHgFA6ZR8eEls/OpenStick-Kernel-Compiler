# 网络与指示灯专项优化（BBR / FQ / TPROXY / LED 内置 / 网桥内置）

# 1. 开启 BBR 拥塞控制与 FQ 队列调度
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# 2. 开启 nftables 透明代理支持（TPROXY）
CONFIG_NFT_TPROXY=y

# 3. 内置 LED 动态触发器（免去开机 modprobe）
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_TIMER=y

# 4. 内置网桥支持（保障开机早期 br0 与 usb0 绑定就绪）
CONFIG_BRIDGE=y
